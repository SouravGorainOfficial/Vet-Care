# GEMINI_API_KEY: Required for Gemini AI API calls (e.g. clinical assistant / species info / consultation notes).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret key for signing sessions / tokens
SESSION_SECRET="vetcare-super-secret-development-key-change-in-production"

# STRIPE PAYMENT INTEGRATION (Optional - platform includes safe mock/fallback mode for development)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
VITE_STRIPE_PUBLISHABLE_KEY=""

# EMAIL SERVICE (Resend or SMTP - fallback to in-memory console logger when empty)
RESEND_API_KEY=""
EMAIL_FROM="VetCare <notifications@vetcare.com>"

# S3 OBJECT STORAGE (AWS S3, MinIO, or Cloudflare R2 - fallback to local base64/data storage)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="vetcare-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# DATABASE CONFIGURATION (PostgreSQL connection string; app contains resilient in-memory & file-backed store for immediate preview)
DATABASE_URL=""

